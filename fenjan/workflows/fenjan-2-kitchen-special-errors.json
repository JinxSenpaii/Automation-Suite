      "id": "1b697117-619c-49ba-be63-3579c5017e2b",
      "name": "Find Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": true,
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const f = $('Kitchen Update').first().json;\nconst id = String(f.order_id ?? f['Order ID'] ?? '').trim().toUpperCase();\nconst status = String(f.status ?? f['Status'] ?? '').trim();\nconst note = String(f.note ?? f['Note for the customer (optional)'] ?? '').trim().slice(0, 300);\n\nconst o = $input.all().map(i => i.json).find(\n  r => String(r.order_id || '').trim().toUpperCase() === id\n);\n\nconst problems = [];\nif (!/^F-\\d{6}-[A-Z0-9]{4}$/.test(id)) {\n  problems.push('Order ID should look like F-261119-AB12');\n} else if (!o) {\n  problems.push(`Order ${id} was not found in the Orders sheet`);\n} else if (['cancelled'].includes(String(o.status || '').toLowerCase()) && status !== 'cancelled') {\n  problems.push(`Order ${id} is already cancelled`);\n}\nif (o && status === 'out_for_delivery' && o.fulfilment !== 'delivery') {\n  problems.push(`Order ${id} is a pickup order`);\n}\n\nconst ar = o?.language === 'ar';\nconst t = (en, a) => ar ? a : en;\n\nconst msgs = {\n  preparing: t(\n    `☕ We are preparing your order ${id} now.`,\n    `☕ بنحضر طلبك ${id} دلوقتي.`\n  ),\n  ready: t(\n    `✅ Your order ${id} is ready for pickup! See you at Fenjan.`,\n    `✅ طلبك ${id} جاهز للاستلام! مستنيينك في فنجان.`\n  ),\n  out_for_delivery: t(\n    `🛵 Your order ${id} is on the way to ${o?.address || 'you'}.`,\n    `🛵 طلبك ${id} في الطريق ليك على ${o?.address || 'عنوانك'}.`\n  ),\n  cancelled: t(\n    `Sorry, we had to cancel order ${id}. Reply here and we will sort it out.`,\n    `للأسف اضطرينا نلغي الطلب ${id}. رد علينا هنا وهنحلها.`\n  )\n};\n\nreturn [{\n  json: {\n    ok: problems.length === 0,\n    problems,\n    order_id: id,\n    status,\n    customer_id: o?.customer_id || '',\n    platform: o?.platform || '',\n    message: (msgs[status] || '') + (note ? '\\n' + note : ''),\n    now: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm')\n  }\n}];"
      },
