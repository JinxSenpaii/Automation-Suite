    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nconst row = $input.all().map(i => i.json).find(\n  r => String(r.date || '').trim() === today\n    && String(r.posted || '').trim().toLowerCase() !== 'yes'\n    && String(r.text || '').trim()\n);\nreturn row ? [{ json: { date: today, text: String(row.text).slice(0, 2000) } }] : [];"
      },
