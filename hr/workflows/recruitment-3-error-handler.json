        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;\"><h2 style=\"color:#dc2626;\">Workflow failure</h2><p><b>Workflow:</b> {{ $('Check Throttle').first().json.workflow }}<br><b>Failed node:</b> {{ $('Check Throttle').first().json.node }}<br><b>Type:</b> {{ $('Check Throttle').first().json.type }} ({{ $('Check Throttle').first().json.severity }})<br><b>Time:</b> {{ $('Check Throttle').first().json.time }}</p><p><b>Error:</b><br><span style=\"color:#6b7280;\">{{ $('Check Throttle').first().json.message }}</span></p><p><b>What to do:</b><br>{{ $('Check Throttle').first().json.fix }}</p><p><a href=\"{{ $('Check Throttle').first().json.executionUrl }}\">Open execution {{ $('Check Throttle').first().json.executionId }}</a></p><p style=\"color:#9ca3af;font-size:12px;\">Further identical alerts are suppressed for 1 hour.</p></div>",
