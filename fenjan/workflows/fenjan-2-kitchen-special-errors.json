    {
      "parameters": {
        "jsCode": "if (Number($json.statusCode || 0) >= 400 || $json.error) {\n  throw new Error('Facebook refused the daily post: ' + String($json.error?.message || $json.headers?.['www-authenticate'] || 'unknown reason').slice(0, 300));\n}\nreturn [{\n  json: {\n    date: $(\"Pick Today's Special\").first().json.date,\n    posted: 'yes',\n    post_id: $json.id || ''\n  }\n}];"
      },
